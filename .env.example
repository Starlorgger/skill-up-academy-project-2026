# SkillUp Academy — Environment Configuration Blueprint
# Created by Tayo Verse Studios

# 1. NODE RUNTIME
PORT=3000
NODE_ENV="production"

# 2. GEMINI AI API (Required for AI Learning Mentor)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 3. APPLICATION DOMAIN
# Public URL where the application is hosted (e.g., https://skillup-academy.com or Cloud Run URL)
APP_URL="http://localhost:3000"

# 4. PAYSTACK MONETIZATION KEYS (Test and Live Modes)
# Obtain from https://dashboard.paystack.com/#/settings/developer
# Test keys start with 'pk_test_' and 'sk_test_'
# Live keys start with 'pk_live_' and 'sk_live_'
PAYSTACK_PUBLIC_KEY="pk_test_sample_sandbox_key"
PAYSTACK_SECRET_KEY="sk_test_sample_sandbox_key"

# 5. OPTIONAL: DATABASE PERSISTENCE (e.g. Firebase / PostgreSQL)
# DATABASE_URL="postgresql://user:password@localhost:5432/skillup"
